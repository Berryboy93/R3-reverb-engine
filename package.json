{
  "name": "r3v4-reverb-engine",
  "version": "1.0.0",
  "description": "R3V4 Reverb Engine — Flagship spatial processor of the R3 NATIVE ecosystem",
  "author": "R3 NATIVE Labs",
  "license": "Proprietary",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "npm run build:processor && vite",
    "build": "npm run build:processor && tsc && vite build",
    "build:plugin": "npm run build:processor && tsc && vite build --mode plugin",
    "build:standalone": "npm run build:processor && tsc && vite build --mode standalone",
    "build:all": "npm run build:plugin && npm run build:standalone",
    "build:processor": "esbuild src/dsp/R3V4Processor.ts --bundle --outfile=public/r3v4-processor.js --format=esm --target=es2020 --minify",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci --no-coverage",
    "test:ui": "jest --no-coverage --verbose",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@types/jest": "^30.0.0",
    "framer-motion": "^11.0.0",
    "jest": "^30.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.4.1",
    "terser": "^5.49.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "keywords": [
    "reverb",
    "dsp",
    "audio-plugin",
    "spatial",
    "r3-native",
    "vst3",
    "au",
    "aax",
    "audio-effect",
    "fdn"
  ]
}
